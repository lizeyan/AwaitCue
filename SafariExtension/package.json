{
  "name": "@awaitcue/safari-extension-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node ../BrowserExtension/scripts/build-safari.mjs",
    "coverage": "vitest run --coverage --coverage.include=Resources/background.js --coverage.include=Resources/protocol.js --coverage.thresholds.statements=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.lines=90",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.3",
    "vitest": "^4.0.3"
  }
}
